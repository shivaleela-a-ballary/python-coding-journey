class Solution:
    def maxNumberOfFamilies(self, n, reservedSeats):
        rows = {}

        # Store reserved seats for each row
        for row, seat in reservedSeats:
            rows.setdefault(row, set()).add(seat)

        # All rows without reservations can fit 2 groups
        answer = (n - len(rows)) * 2

        for seats in rows.values():

            left = {2, 3, 4, 5}
            middle = {4, 5, 6, 7}
            right = {6, 7, 8, 9}

            # Check which blocks are free
            can_left = not (seats & left)
            can_middle = not (seats & middle)
            can_right = not (seats & right)

            if can_left and can_right:
                # Two non-overlapping groups
                answer += 2

            elif can_left or can_middle or can_right:
                # At least one group can fit
                answer += 1

        return answer
