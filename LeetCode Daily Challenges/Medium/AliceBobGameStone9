class Solution:
    def stoneGameIX(self, stones):
        cnt = [0, 0, 0]

        for x in stones:
            cnt[x % 3] += 1

        # If there are no stones with remainder 1 or 2,
        # Alice must take a remainder-0 stone and loses.
        if cnt[1] == 0 and cnt[2] == 0:
            return False

        # If the number of remainder-0 stones is even,
        # they don't change the winner.
        if cnt[0] % 2 == 0:
            return cnt[1] > 0 and cnt[2] > 0

        # If remainder-0 count is odd
        # Alice wins if one of these conditions holds.
        return abs(cnt[1] - cnt[2]) > 2
