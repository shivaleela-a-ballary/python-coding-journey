class Solution:
    def gameOfLife(self, board: List[List[int]]) -> None:
        """
        Do not return anything, modify board in-place instead.
        """
        
        m = len(board)
        n = len(board[0])

        for i in range(m):
            for j in range(n):
                neighbors = 0

                for r in range(i - 1, i + 2):
                    for c in range(j - 1, j + 2):
                        if 0 <= r < m and 0 <= c < n and (board[r][c] == 1 or board[r][c] == 3):
                            neighbors += 1
                
                if board[i][j] == 1 or board[i][j] == 3:
                    neighbors -= 1

                if (board[i][j] == 0 or board[i][j] == 2) and neighbors == 3:
                    board[i][j] = 2
                elif (board[i][j] == 1 or board[i][j] == 3) and 2 <= neighbors <= 3:
                    board[i][j] = 3
        
        for i in range(m):
            for j in range(n):
                board[i][j] = board[i][j] // 2
                
