class Solution:
    def stoneGameII(self, piles):
        n = len(piles)
        suffix = [0] * (n + 1)

        for i in range(n - 1, -1, -1):
            suffix[i] = suffix[i + 1] + piles[i]

        dp = {}

        def solve(i, M):
            if i == n:
                return 0

            if (i, M) in dp:
                return dp[(i, M)]

            best = 0

            for X in range(1, 2 * M + 1):
                if i + X > n:
                    break

                taken = suffix[i] - suffix[i + X]
                opponent = solve(i + X, max(M, X))

                best = max(best, taken + suffix[i + X] - opponent)

            dp[(i, M)] = best
            return best

        return solve(0, 1)
